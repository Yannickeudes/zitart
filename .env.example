# SQLite par défaut (aucune configuration nécessaire).
# Pour PostgreSQL : DATABASE_URL="postgresql://user:pass@host:5432/zitart" et changez le provider dans prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Secret pour signer les sessions (obligatoire en production)
AUTH_SECRET="change-me"

# URL publique du site (utilisée pour les métadonnées et uploads)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
